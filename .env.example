# Modèle de configuration : copier en `.env` (non versionné) puis remplacer les valeurs.
#   cp .env.example .env
# Lu par docker-compose.yml ET par l'application (indusense.settings).

# --- PostgreSQL -------------------------------------------------------------
DB_TAG=15.1
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=indusense_db
DB_USER=indusense_user
DB_PASSWORD=change-me
DB_DATA_VOLUME=pg-db-data

# --- pgAdmin ----------------------------------------------------------------
GUI_TAG=6.15
GUI_PORT=8080
GUI_EMAIL=admin@example.org
GUI_PASSWORD=change-me
GUI_DATA_VOLUME=pg-gui-data

# --- Supervision ------------------------------------------------------------
PROMETHEUS_TAG=v2.54.1
PROMETHEUS_PORT=9090
PROMETHEUS_DATA_VOLUME=prometheus-data

ALERTMANAGER_TAG=v0.27.0
ALERTMANAGER_PORT=9093
ALERTMANAGER_DATA_VOLUME=alertmanager-data

GRAFANA_TAG=11.2.0
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_DATA_VOLUME=grafana-data

# --- Application ------------------------------------------------------------
# API scrapée par Prometheus via host.docker.internal (doit écouter sur 0.0.0.0)
API_HOST=0.0.0.0
API_PORT=8000

# Clé secrète HMAC-SHA-256 pour la pseudonymisation (SILVER / ANO).
# Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
PSEUDONYMIZATION_KEY=
